{
  "kind": "collectionType",
  "collectionName": "blogs",
  "info": {
    "displayName": "Blog",
    "singularName": "blog",
    "pluralName": "blogs",
    "description": "Blog articles shown on /resources/blog. Mirrors the production blog schema."
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "richtext"
    },
    "author": {
      "type": "string"
    },
    "date": {
      "type": "date"
    },
    "category_id": {
      "type": "integer"
    },
    "creation_date": {
      "type": "datetime"
    },
    "modification_date": {
      "type": "datetime"
    },
    "flag": {
      "type": "boolean",
      "default": false
    },
    "meta_title": {
      "type": "string"
    },
    "meta_description": {
      "type": "text"
    },
    "meta_keyword": {
      "type": "string"
    },
    "us_title": {
      "type": "string"
    },
    "us_description": {
      "type": "text"
    },
    "published": {
      "type": "boolean",
      "default": true
    },
    "images": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": ["images"]
    }
  }
}
